# Copy to .env.production.local (git-ignored) for release builds.
#
# 'test' (default) = Google's public test ads, safe everywhere.
# 'live'           = the real ad units below. Only for the Play release build.
VITE_ADS_MODE=live

# AdMob rewarded ad unit ids (AdMob → Apps → Ad units). Note the "/".
VITE_ADMOB_REWARDED_DOUBLE=ca-app-pub-0000000000000000/0000000000
VITE_ADMOB_REWARDED_REVIVE=ca-app-pub-0000000000000000/0000000000
VITE_ADMOB_REWARDED_GEMS=ca-app-pub-0000000000000000/0000000000

# Optional: hashed ids of your own phones, always served test ads even in a
# live build (find it in `adb logcat | grep -i "test device"`). Comma-separated.
VITE_ADMOB_TEST_DEVICES=

# Show gem packs + support tiers (needs Google Play Billing first).
VITE_FEATURE_IAP=false
