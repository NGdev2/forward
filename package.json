{
  "name": "forward-runner",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "cap:sync": "vite build && npx cap sync android",
    "cap:open": "npx cap open android",
    "sim": "esbuild scripts/sim.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=node_modules/.cache/forward-sim.cjs && node node_modules/.cache/forward-sim.cjs",
    "i18n:check": "npx esbuild scripts/i18n-check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/i18n-check.cjs --log-level=warning && node node_modules/.cache/i18n-check.cjs",
    "android:debug": "vite build --mode development && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "./scripts/android-release.sh bundle",
    "icons": "node scripts/icons/render.cjs",
    "store:images": "node scripts/store/capture.cjs 5196 && node scripts/store/frames.cjs && python3 scripts/store/to-jpeg.py"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "playwright": "^1.47.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  }
}
