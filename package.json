{
  "name": "forward-runner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "cap:sync": "vite build && npx cap sync android",
    "cap:open": "npx cap open android",
    "sim": "esbuild scripts/sim.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=node_modules/.cache/forward-sim.cjs && node node_modules/.cache/forward-sim.cjs"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "playwright": "^1.47.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
