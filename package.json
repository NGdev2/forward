{
  "name": "forward-runner",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "cap:sync": "vite build && npx cap sync android",
    "cap:open": "npx cap open android",
    "sim": "esbuild scripts/sim.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=node_modules/.cache/forward-sim.cjs && node node_modules/.cache/forward-sim.cjs",
    "i18n:check": "npx esbuild scripts/i18n-check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/i18n-check.cjs --log-level=warning && node node_modules/.cache/i18n-check.cjs",
    "android:debug": "vite build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "./scripts/android-release.sh bundle"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "playwright": "^1.47.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
